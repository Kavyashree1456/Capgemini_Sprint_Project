<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
  
    <!-- Chrome -->
    <test name="Chrome Test">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testScripts.InventoryTest"/>
            <class name="testScripts.CartTest"/>
            <class name="testScripts.CheckoutTest"/>
            <class name="testScripts.CheckoutCompleteTest"/>
            <class name="testScripts.LoginTest"/>
        </classes>

    </test>


    <!-- Firefox -->
    <test name="Firefox Test">

        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="testScripts.InventoryTest"/>
            <class name="testScripts.CartTest"/>
            <class name="testScripts.CheckoutTest"/>
            <class name="testScripts.CheckoutCompleteTest"/>
            <class name="testScripts.LoginTest"/>
        </classes>

    </test>


    <!-- Edge -->
    <test name="Edge Test">

        <parameter name="browser" value="edge"/>

        <classes>
            <class name="testScripts.InventoryTest"/>
            <class name="testScripts.CartTest"/>
            <class name="testScripts.CheckoutTest"/>
            <class name="testScripts.CheckoutCompleteTest"/>
            <class name="testScripts.LoginTest"/>
        </classes>

    </test>
  
</suite> <!-- Suite -->
